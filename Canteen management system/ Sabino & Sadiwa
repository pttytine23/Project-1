    <!-- JAVASCRIPT LOGIC -->
    <script>
        const products = [
            { id: 1, name: 'Chicken Arroz Caldo', price: 35, category: 'meals', icon: 'fa-bowl-food' },
            { id: 2, name: 'Pancit Bihon', price: 30, category: 'meals', icon: 'fa-utensils' },
            { id: 3, name: 'Tuna Sandwich', price: 25, category: 'snacks', icon: 'fa-burger' },
            { id: 4, name: 'Buko Juice', price: 15, category: 'drinks', icon: 'fa-bottle-water' }
        ];

        let cart = [];

        function switchTab(tabName) {
            ['dashboard', 'pos', 'inventory', 'reports'].forEach(tab => {
                document.getElementById(tab-${tab}).classList.toggle('hidden', tab !== tabName);
                document.getElementById(nav-${tab}).className = tab === tabName 
                    ? "w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium transition bg-white/20 text-white shadow-sm"
                    : "w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium transition text-gray-300 hover:bg-white/10 hover:text-white";
            });
            if (tabName === 'pos') renderPosProducts('all');
        }

        function handleLogin(e) {
            e.preventDefault();
            document.getElementById('loginView').classList.add('hidden');
            document.getElementById('appContainer').classList.remove('hidden');
        }

        function handleLogout() {
            document.getElementById('appContainer').classList.add('hidden');
            document.getElementById('loginView').classList.remove('hidden');
        }

        function showCustomAlert(msg) {
            document.getElementById('alertMessageText').innerText = msg;
            document.getElementById('customAlertModal').classList.remove('hidden');
        }

        function closeCustomAlert() {
            document.getElementById('customAlertModal').classList.add('hidden');
        }

        function renderPosProducts(category) {
            const grid = document.getElementById('posProductGrid');
            grid.innerHTML = '';
            const filtered = category === 'all' ? products : products.filter(p => p.category === category);
            
            filtered.forEach(p => {
                const card = document.createElement('div');
                card.className = "bg-white p-4 rounded-xl border border-gray-200 shadow-sm flex flex-col justify-between hover:border-[#4a2213] transition cursor-pointer";
                card.onclick = () => addToCart(p.id);
                card.innerHTML = `
                    <div>
                        <div class="w-10 h-10 rounded-lg bg-[#fdfbe4] flex items-center justify-center text-[#4a2213] text-lg mb-2"><i class="fa-solid ${p.icon}"></i></div>
                        <h4 class="font-bold text-gray-900 text-xs">${p.name}</h4>
                        <span class="text-[10px] text-gray-400 capitalize">${p.category}</span>
                    </div>
                    <div class="mt-3 flex items-center justify-between">
                        <span class="font-black text-[#4a2213] text-sm">₱${p.price.toFixed(2)}</span>
                        <button class="w-6 h-6 rounded-full bg-[#4a2213] text-white flex items-center justify-center text-xs">+</button>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function filterPosCategory(category) {
            document.querySelectorAll('.pos-cat-btn').forEach(b => b.className = "pos-cat-btn px-4 py-2 rounded-lg text-xs font-bold transition bg-white text-gray-700 hover:bg-gray-100 border border-gray-200");
            document.getElementById(cat-${category}).className = "pos-cat-btn px-4 py-2 rounded-lg text-xs font-bold transition bg-[#4a2213] text-white";
            renderPosProducts(category);
        }

        function addToCart(id) {
            const product = products.find(p => p.id === id);
            const item = cart.find(i => i.id === id);
            if (item) item.qty++;
            else cart.push({ ...product, qty: 1 });
            updateCartUI();
        }

        function updateCartUI() {
            const list = document.getElementById('cartItemsList');
            const totalEl = document.getElementById('cartTotal');
            if (cart.length === 0) {
                list.innerHTML = <p class="text-xs text-gray-400 text-center py-8">No items added to order yet.</p>;
                totalEl.innerText = '₱0.00';
                return;
            }
            list.innerHTML = '';
            let total = 0;
            cart.forEach(item => {
                total += item.price * item.qty;
                const row = document.createElement('div');
                row.className = "flex items-center justify-between bg-gray-50 p-2.5 rounded-lg border text-xs";
                row.innerHTML = <span>${item.name} (x${item.qty})</span><span class="font-bold">₱${(item.price * item.qty).toFixed(2)}</span>;
                list.appendChild(row);
            });
            totalEl.innerText = ₱${total.toFixed(2)};
        }

        function clearCart() { cart = []; updateCartUI(); }
        function processCheckout() {
            if (cart.length === 0) { showCustomAlert('Cart is empty.'); return; }
            showCustomAlert('Transaction completed successfully!');
            clearCart();
        }
    </script>
</body>
</html>
